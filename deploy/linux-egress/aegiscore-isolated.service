[Unit]
Description=AEGISCORE API in a default-deny loopback network namespace
After=local-fs.target
RequiresMountsFor=/opt/aegiscore /var/lib/aegiscore
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/aegiscore/linux-egress.conf
ExecStart=/usr/bin/python3 /opt/aegiscore/deploy/linux-egress/run_isolated.py --config /etc/aegiscore/linux-egress.conf
Restart=on-failure
RestartSec=3
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN

[Install]
WantedBy=multi-user.target
